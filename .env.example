# ==============================================================================
# منصة اتحاد طلاب جامعة الإسكندرية • المتغيرات البيئية (Environment Variables)
# ==============================================================================

# 1. عنوان مشروع سوبابيز (Supabase Project URL)
# يمكن الحصول عليه من Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. مفتاح الوصول المجهول (Supabase Anon Key / Public API Key)
# يمكن الحصول عليه من Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
